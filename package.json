{
  "name": "dispute-court",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "node --test packages/*/test/*.test.ts apps/*/test/*.test.ts examples/*/test/*.test.ts",
    "compile": "node packages/contracts/scripts/compile.ts",
    "court": "node apps/court/src/main.ts",
    "demo": "node examples/demos/demo.ts",
    "demo:sourcing": "node examples/demos/sourcing-demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@metalntwx/metal-agent": "0.3.3",
    "@metalntwx/metal-pay": "0.3.3",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/express": "2.28.0",
    "express": "5.3.0",
    "viem": "2.57.13"
  },
  "devDependencies": {
    "solc": "0.8.28"
  }
}
